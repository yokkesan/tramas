# Development only. Run: python3 scripts/setup-dev-env.py
# The setup script supplies separate, random local-only passwords.
COMPOSE_PROJECT_NAME=tramas-dev
POSTGRES_DB=tramas_dev
POSTGRES_USER=tramas_owner
POSTGRES_PASSWORD=
APP_DB_USER=tramas_app
APP_DB_PASSWORD=
MIGRATION_DB_USER=tramas_migrator
MIGRATION_DB_PASSWORD=
DEV_HTTP_PORT=8080

# Provisional registration settings; review before public release.
REGISTER_PASSWORD_MIN=15
REGISTER_PASSWORD_MAX=128
REGISTER_ARGON_MEMORY_KIB=19456
REGISTER_ARGON_ITERATIONS=2
REGISTER_ARGON_PARALLELISM=1
REGISTER_HASH_CONCURRENCY=2
REGISTER_RATE_PER_MINUTE=5
REGISTER_RATE_BURST=2
REGISTER_RATE_MAX_CLIENTS=10000
# Optional additional blocklist, mounted read-only at this container path.
REGISTER_BLOCKLIST_PATH=
TRAMAS_PROXY_SUBNET=10.93.17.0/24
TRAMAS_PROXY_DYNAMIC_RANGE=10.93.17.128/25
TRAMAS_PROXY_IP=10.93.17.2
