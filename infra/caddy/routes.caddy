encode gzip
header {
	X-Content-Type-Options nosniff
	Referrer-Policy no-referrer
	-Server
}
log {
	output stdout
	format filter {
		wrap json
		fields {
			# Includes the development inbox key and any future credential headers.
			request>headers delete
			resp_headers delete
			request>uri query {
				delete token
				delete access_token
				delete refresh_token
				delete id_token
				delete challenge_token
				delete reauth_token
				delete nonce
				delete code
				delete state
				delete password
				delete email
			}
		}
	}
}
reverse_proxy api:8080 {
	health_uri /health
	health_interval 10s
	health_timeout 3s
}
